PORT=3000
NODE_ENV=development
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?appName=<app-name>

# Адреси фронтенду, яким дозволено ходити в API з куками (CORS).
# Можна вказати кілька через кому, без слеша в кінці:
#   CLIENT_URL=https://harmoniq.vercel.app,https://harmoniq-preview.vercel.app
# Для локальної розробки заповнювати не обов'язково: поки NODE_ENV !== production,
# http://localhost:3000 і http://localhost:3001 дозволені автоматично.
CLIENT_URL=

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>




